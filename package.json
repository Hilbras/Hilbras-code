{
  "name": "hilbras-code",
  "version": "0.1.0",
  "description": "A fast, extensible coding agent CLI. Structural code edits, MCP tools, cloud and local models, one binary for macOS, Linux and Windows.",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "codex",
    "cline",
    "mcp",
    "llm",
    "terminal",
    "tui",
    "developer-tools",
    "anthropic",
    "openai",
    "ollama"
  ],
  "homepage": "https://github.com/Hilbras/Hilbras-code#readme",
  "bugs": "https://github.com/Hilbras/Hilbras-code/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilbras/Hilbras-code.git",
    "directory": "/"
  },
  "license": "MIT",
  "author": "Hilbras <hi@hilbras.dev> (https://github.com/Hilbras)",
  "type": "module",
  "bin": {
    "hilbras-code": "bin/hilbras-code.mjs",
    "hcode": "bin/hilbras-code.mjs"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "web-tree-sitter": "^0.25.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.3"
  }
}
