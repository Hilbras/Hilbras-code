{
  "name": "@hilbras/code",
  "version": "0.1.0",
  "description": "A fast coding agent CLI. Unambiguous file edits, cloud and local models, one binary for macOS, Linux and Windows.",
  "keywords": [
    "ai",
    "ai-agent",
    "agent",
    "cli",
    "coding-agent",
    "code-agent",
    "codex",
    "cline",
    "llm",
    "terminal",
    "developer-tools",
    "anthropic",
    "openai",
    "ollama",
    "bun"
  ],
  "homepage": "https://github.com/Hilbras/Hilbras-code#readme",
  "bugs": "https://github.com/Hilbras/Hilbras-code/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilbras/Hilbras-code.git",
    "directory": "/"
  },
  "license": "MIT",
  "author": "Hilbras <hi@hilbras.dev> (https://github.com/Hilbras)",
  "type": "module",
  "bin": {
    "hilbras-code": "bin/hilbras-code.mjs",
    "hcode": "bin/hilbras-code.mjs"
  },
  "files": ["bin/hilbras-code.mjs", "src", "scripts/postinstall.mjs", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "execa": "^9.5.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.3"
  }
}
